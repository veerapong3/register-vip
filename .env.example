# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (อย่า commit .env.local)

# Google Sheets — แชร์ชีตให้ Service Account เป็น Editor
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=

# Google Drive — โฟลเดอร์สลิป + OAuth ของเจ้าของโฟลเดอร์
GOOGLE_DRIVE_SLIP_FOLDER_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# แสดงบนหน้าเว็บ (ข้อมูลบัญชีโอนเงิน — เป็นข้อมูลสาธารณะ)
NEXT_PUBLIC_BANK_NAME=ธนาคารไทยพาณิชย์
NEXT_PUBLIC_BANK_ACCOUNT=418-002259-4
NEXT_PUBLIC_BANK_HOLDER=นายวีระพงศ์ ตะโกนอก

# แอดมินอัปเดตสถานะชำระเงิน (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# แนะนำตั้งค่าแยก (ถ้าไม่ตั้งจะใช้ ADMIN_PASSWORD เป็น secret เซ็นคุกกี้)
ADMIN_SESSION_SECRET=
